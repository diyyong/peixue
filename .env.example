# ------------------------------------------------------------
# Peixue / 陪学笔记
# Copy this file to .env before using Docker Compose:
#   cp .env.example .env
# Never commit the resulting .env file.
# ------------------------------------------------------------

# Public web port used by Docker Compose
APP_PORT=8080

# MySQL. Replace both passwords before the first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peixue
DB_USER=peixue
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Backend. Docker Compose overrides HOST and DB_HOST internally.
HOST=127.0.0.1
PORT=3001

# Optional comma-separated origins for a separately hosted frontend.
# Leave empty when frontend and API share one origin (the Docker default).
# Example: CORS_ORIGIN=https://peixue.example.com
CORS_ORIGIN=

# OpenAI-compatible /chat/completions endpoint.
# Peixue has been designed around GLM/Doubao-style response fields; verify
# model compatibility before relying on a different provider in production.
AI_ENDPOINT=https://your-provider.example/v1/chat/completions
AI_API_KEY=replace-with-your-provider-api-key
AI_MODEL=replace-with-your-text-model

# Optional endpoint-specific models. Empty values inherit AI_MODEL.
AI_MODEL_ANALYZE=
AI_MODEL_QUIZ=
AI_MODEL_EXPLANATION=
AI_VISION_MODEL=replace-with-your-vision-model

# enabled | disabled | auto
AI_THINKING=enabled
AI_THINKING_ANALYZE=
AI_THINKING_VISION=
AI_THINKING_QUIZ=
AI_THINKING_EXPLANATION=

# Set false if the provider rejects response_format=json_object.
AI_USE_JSON_FORMAT=true

# Only used once when migrating a legacy v3 database. New installs should
# create families with the admin CLI instead.
ACCESS_PASSWORD=
